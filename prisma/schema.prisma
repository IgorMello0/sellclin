  totalRecipients   Int            @default(0) @map("total_recipients")
  sentCount         Int            @default(0) @map("sent_count")
  failedCount       Int            @default(0) @map("failed_count")
  mediaUrl          String?        @map("media_url") @db.Text
  mediaType         String?        @map("media_type") // 'image', 'video', 'audio'
  minDelay          Int            @default(180) @map("min_delay")
  maxDelay          Int            @default(200) @map("max_delay")
  randomize         Boolean        @default(false)
  variations        Json? // Array de strings com as variações de mensagens
  templateSnapshot  Json?          @map("template_snapshot")
  providerSnapshot  String?        @map("provider_snapshot")
  connectionMode    String?        @map("connection_mode")
  workerHeartbeatAt DateTime?      @map("worker_heartbeat_at")
  messageUnitCostCents Int         @default(5) @map("message_unit_cost_cents")
  creditReservedCents  Int         @default(0) @map("credit_reserved_cents")
  creditSpentCents     Int         @default(0) @map("credit_spent_cents")
  creditRefundedCents  Int         @default(0) @map("credit_refunded_cents")
  scheduledAt       DateTime?      @map("scheduled_at") // Data de agendamento (se agendada)
  startedAt         DateTime?      @map("started_at") // Quando começou a enviar
  completedAt       DateTime?      @map("completed_at") // Quando finalizou
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relacionamentos
  company      Empresa             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  template     WhatsAppTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]
  creditTransactions MessageCreditTransaction[]

  @@map("message_campaigns")
}

// Destinatários individuais de cada campanha
model CampaignRecipient {
  id         Int    @id @default(autoincrement())
  campaignId Int    @map("campaign_id")
  name       String // Nome do destinatário
  phone      String // Telefone do destinatário
  sourceType String @map("source_type") // 'lead', 'client' ou 'spreadsheet'
  sourceId   Int?   @map("source_id") // ID do lead/client; nulo para planilha

  status            RecipientStatus @default(pending)
  providerMessageId String?         @map("provider_message_id")
  attempts          Int             @default(0)
  processingAt      DateTime?       @map("processing_at")
  nextAttemptAt     DateTime?       @map("next_attempt_at")
  sentAt            DateTime?       @map("sent_at")
  deliveredAt       DateTime?       @map("delivered_at")
  readAt            DateTime?       @map("read_at")
  failedAt          DateTime?       @map("failed_at")
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  renderedMessage   String?         @map("rendered_message") @db.Text // Mensagem final renderizada
  variables         Json? // Dados extras para variaveis de planilha, como data, hora e especialista
  createdAt         DateTime        @default(now()) @map("created_at")

  // Relacionamentos
  campaign MessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creditTransactions MessageCreditTransaction[]

  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@map("campaign_recipients")
}
