  priority         String   @default("medium") // low, medium, high, urgent
  dueDate          DateTime @map("due_date")
  assignedToId     Int?     @map("assigned_to_id")
  assignedToUserId Int?     @map("assigned_to_user_id")
  createdById      Int?     @map("created_by_id")
  createdByUserId  Int?     @map("created_by_user_id")
  companyId        Int      @map("company_id")
  clientId         Int?     @map("client_id")
  leadId           Int?     @map("lead_id")
  isRecurring      Boolean  @default(false) @map("is_recurring")
  recurrenceRule   String?  @map("recurrence_rule") // daily, weekly, monthly
  parentTaskId     Int?     @map("parent_task_id")
  cadenceStageCode String?  @map("cadence_stage_code")
  cadenceStepIndex Int?     @map("cadence_step_index")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignedTo     Professional?  @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToUser Usuario?       @relation("AssignedUserTasks", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  createdBy      Professional?  @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  createdByUser  Usuario?       @relation("CreatedUserTasks", fields: [createdByUserId], references: [id], onDelete: Cascade)
  company        Empresa        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parentTask     Task?          @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]         @relation("SubTasks")
  notifications  Notification[]

  @@map("tasks")
}

