generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Professional {
  id                  Int                      @id @default(autoincrement())
  name                String
  email               String                   @unique
  passwordHash        String                   @map("password_hash")
  phone               String?
  specialization      String?
  companyId           Int?                     @map("company_id")
  companyName         String?                  @map("company_name")
  logoUrl             String?                  @map("logo_url")
  contractType        String?                  @map("contract_type")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  bio                 String?                  @db.Text
  crm                 String?
  photoUrl            String?                  @map("photo_url")
  onboardingCompleted Boolean                  @default(false) @map("onboarding_completed")
  onboardingData      Json?                    @map("onboarding_data")
  googleId            String?                  @unique @map("google_id")
  authProvider        String?                  @default("local") @map("auth_provider")
  emailVerified       Boolean                  @default(true) @map("email_verified")
  emailVerifiedAt     DateTime?                @map("email_verified_at")
  appointments        Appointment[]
  auditLogs           AuditLog[]
  catalogItems        CatalogItem[]
  categories          Category[]
  chatHistories       ChatHistory[]
  clients             Client[]
  contracts           Contract[]
  conversas           Conversa[]
  conversasAtribuidas Conversa[]               @relation("ConversationAssignedProfessional")
  conversationNotes   ConversationNote[]       @relation("ConversationNoteProfessional")
  conversationEvents  ConversationEvent[]      @relation("ConversationEventProfessional")
  ownedCompanies      Empresa[]                @relation("CompanyOwner")
  fichaTemplates      FichaTemplate[]
  fichas              Ficha[]
  goals               Goal[]
  leads               Lead[]
  payments            Payment[]
  permissions         ProfessionalPermission[]
  company             Empresa?                 @relation("CompanyProfessionals", fields: [companyId], references: [id])
  roles               Role[]
  settingsProfile     SettingsProfile?
  assignedTasks       Task[]                   @relation("AssignedTasks")
  createdTasks        Task[]                   @relation("CreatedTasks")
  notifications       Notification[]
  messageCampaigns    MessageCampaign[]
  billingAddons       BillingAddon[]

  @@map("professionals")
}

model Client {
  id             Int           @id @default(autoincrement())
  professionalId Int           @map("professional_id")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?     @map("date_of_birth")
  document       String?
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tags           String[]      @default([])
  avatar         String?
  city           String?
  socialMedia    String?       @map("social_media")
  companyId      Int?          @map("company_id")
  appointments   Appointment[]
  chatHistories  ChatHistory[]
  company        Empresa?      @relation(fields: [companyId], references: [id])
  professional   Professional  @relation(fields: [professionalId], references: [id])
  conversas      Conversa[]
  fichas         Ficha[]
  originLead     Lead?
  payments       Payment[]
  tasks          Task[]

  @@map("clients")
}

model LeadStatus {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String
  label     String
  color     String   @default("bg-slate-100 text-slate-600 border-slate-200")
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Empresa @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("lead_statuses")
}

model LeadOriginConfig {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  value     String
  label     String
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Empresa @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, value])
  @@map("lead_origins")
}

model Lead {
  id                   Int            @id @default(autoincrement())
  professionalId       Int            @map("professional_id")
  name                 String
  value                Decimal        @default(0) @db.Decimal(10, 2)
  origin               String?
  avatar               String?
  status               String
  phone                String
  email                String?
  responsible          String?
  isScheduled          Boolean        @default(false) @map("is_scheduled")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  convertedAt          DateTime?      @map("converted_at")
  attendedAt           DateTime?      @map("attended_at")
  proposalAt           DateTime?      @map("proposal_at")
  closedAt             DateTime?      @map("closed_at")
  convertedToClientId  Int?           @unique @map("converted_to_client_id")
  tags                 String[]       @default([])
  contactCount         Int            @default(0) @map("contact_count")
  discountApplied      Boolean        @default(false) @map("discount_applied")
  justification        String?
  remarketingProposals Json?          @map("remarketing_proposals")
  isPaid               Boolean        @default(false) @map("is_paid")
  notes                String?
  subStatus            String?        @map("sub_status")
  companyId            Int?           @map("company_id")
  sdrId                Int?           @map("sdr_id")
  closerId             Int?           @map("closer_id")
  especialistaId       Int?           @map("especialista_id")
  appointments         Appointment[]
  activities           LeadActivity[]
  company              Empresa?       @relation(fields: [companyId], references: [id])
  convertedToClient    Client?        @relation(fields: [convertedToClientId], references: [id])
  professional         Professional   @relation(fields: [professionalId], references: [id])
  sdr                  Usuario?       @relation("LeadSdr", fields: [sdrId], references: [id])
  closer               Usuario?       @relation("LeadCloser", fields: [closerId], references: [id])
  especialista         Usuario?       @relation("LeadEspecialista", fields: [especialistaId], references: [id])
  proposals            Proposal[]
  tasks                Task[]
  conversas            Conversa[]

  @@unique([phone, companyId])
  @@map("leads")
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  type      String
  content   String
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model Proposal {
  id                 Int      @id @default(autoincrement())
  leadId             Int      @map("lead_id")
  title              String
  value              Decimal  @db.Decimal(10, 2)
  validUntil         DateTime @map("valid_until")
  salespersonId      Int?     @map("salesperson_id")
  specialistId       Int?     @map("specialist_id")
  sdrId              Int?     @map("sdr_id")
  tags               String[] @default([])
  status             String   @default("pending")
  justification      String?
  discountApplied    Boolean  @default(false) @map("discount_applied")
  discountValue      Decimal? @map("discount_value")
  discountPercentage Decimal? @map("discount_percentage")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesperson        Usuario? @relation("SalespersonProposals", fields: [salespersonId], references: [id])
  specialist         Usuario? @relation("SpecialistProposals", fields: [specialistId], references: [id])
  sdr                Usuario? @relation("SdrProposals", fields: [sdrId], references: [id])

  @@map("proposals")
}

model Category {
  id             Int            @id @default(autoincrement())
  professionalId Int            @map("professional_id")
  name           String
  description    String?
  status         CategoryStatus @default(ativo)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  catalogItems   CatalogItem[]
  professional   Professional   @relation(fields: [professionalId], references: [id])

  @@map("categories")
}

model CatalogItem {
  id              Int               @id @default(autoincrement())
  professionalId  Int               @map("professional_id")
  categoryId      Int?              @map("category_id")
  name            String
  description     String?
  price           Decimal           @db.Decimal(10, 2)
  imageUrl        String?           @map("image_url")
  status          CatalogItemStatus @default(rascunho)
  durationMinutes Int?              @map("duration_minutes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  appointments    Appointment[]
  category        Category?         @relation(fields: [categoryId], references: [id])
  professional    Professional      @relation(fields: [professionalId], references: [id])

  @@map("catalog_items")
}

model Appointment {
  id               Int                      @id @default(autoincrement())
  professionalId   Int                      @map("professional_id")
  clientId         Int?                     @map("client_id")
  serviceId        Int?                     @map("service_id")
  startTime        DateTime                 @map("start_time")
  endTime          DateTime                 @map("end_time")
  status           AppointmentStatus        @default(agendado)
  notes            String?
  googleEventId    String?                  @map("google_event_id")
  googleCalendarId String?                  @map("google_calendar_id")
  googleSyncStatus GoogleCalendarSyncStatus @default(not_synced) @map("google_sync_status")
  googleSyncError  String?                  @map("google_sync_error")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  leadId           Int?                     @map("lead_id")
  companyId        Int?                     @map("company_id")
  sdrId            Int?                     @map("sdr_id")
  especialistaId   Int?                     @map("especialista_id")
  appointmentLogs  AppointmentLog[]
  client           Client?                  @relation(fields: [clientId], references: [id])
  company          Empresa?                 @relation(fields: [companyId], references: [id])
  lead             Lead?                    @relation(fields: [leadId], references: [id])
  professional     Professional             @relation(fields: [professionalId], references: [id])
  sdr              Usuario?                 @relation("AppointmentSDR", fields: [sdrId], references: [id])
  especialista     Usuario?                 @relation("AppointmentEspecialista", fields: [especialistaId], references: [id])
  service          CatalogItem?             @relation(fields: [serviceId], references: [id])
  payments         Payment[]

  @@map("appointments")
}

model AppointmentLog {
  id            Int                  @id @default(autoincrement())
  appointmentId Int                  @map("appointment_id")
  action        AppointmentLogAction
  timestamp     DateTime
  userAction    UserActionType       @map("user_action")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  appointment   Appointment          @relation(fields: [appointmentId], references: [id])

  @@map("appointment_logs")
}

model Payment {
  id              Int           @id @default(autoincrement())
  appointmentId   Int?          @map("appointment_id")
  clientId        Int           @map("client_id")
  professionalId  Int           @map("professional_id")
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(pendente)
  referencePeriod String?       @map("reference_period")
  date            DateTime
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  companyId       Int?          @map("company_id")
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company         Empresa?      @relation(fields: [companyId], references: [id])
  professional    Professional  @relation(fields: [professionalId], references: [id])

  @@map("payments")
}

model FichaTemplate {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  category    String?
  fields      Json
  createdBy   Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  creator     Professional @relation(fields: [createdBy], references: [id])
  fichas      Ficha[]

  @@map("ficha_templates")
}

model Ficha {
  id             Int            @id @default(autoincrement())
  clientId       Int            @map("client_id")
  professionalId Int            @map("professional_id")
  type           FichaType
  templateId     Int?           @map("template_id")
  content        Json
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  client         Client         @relation(fields: [clientId], references: [id])
  professional   Professional   @relation(fields: [professionalId], references: [id])
  template       FichaTemplate? @relation(fields: [templateId], references: [id])

  @@map("fichas")
}

model ChatHistory {
  id             Int          @id @default(autoincrement())
  clientId       Int?         @map("client_id")
  professionalId Int          @map("professional_id")
  sessionId      String?      @map("session_id")
  message        String
  sender         ChatSender
  timestamp      DateTime
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  client         Client?      @relation(fields: [clientId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@map("chat_histories")
}

model SettingsProfile {
  id             Int          @id @default(autoincrement())
  professionalId Int          @unique @map("professional_id")
  theme          ThemeType    @default(light)
  signatureUrl   String?      @map("signature_url")
  preferences    Json?
  language       String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@map("settings_profile")
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  action      String
  targetTable String       @map("target_table")
  targetId    Int?         @map("target_id")
  timestamp   DateTime
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        Professional @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Contract {
  id             Int              @id @default(autoincrement())
  professionalId Int              @map("professional_id")
  contractType   ContractTypeEnum @map("contract_type")
  documentUrl    String?          @map("document_url")
  startDate      DateTime         @map("start_date")
  endDate        DateTime?        @map("end_date")
  status         ContractStatus   @default(ativo)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  professional   Professional     @relation(fields: [professionalId], references: [id])

  @@map("contracts")
}

model Empresa {
  id                     Int       @id @default(autoincrement())
  ownerId                Int?      @map("owner_id")
  name                   String
  logoUrl                String?   @map("logo_url")
  domain                 String?
  whatsapp               String?
  whatsappProvider       String?   @default("evolution") @map("whatsapp_provider")
  apiKey                 String?   @map("api_key")
  evolutionApiUrl        String?   @map("evolution_api_url")
  evolutionInstance      String?   @map("evolution_instance")
  evolutionMode          String?   @map("evolution_mode")
  metaToken              String?   @map("meta_token")
  metaPhoneNumberId      String?   @map("meta_phone_number_id")
  metaWabaId             String?   @map("meta_waba_id")
  metaBusinessId         String?   @map("meta_business_id")
  metaPhoneDisplayNumber String?   @map("meta_phone_display_number")
  metaWebhookVerifyToken String?   @map("meta_webhook_verify_token")
  metaTwoStepPin         String?   @map("meta_two_step_pin")
  metaConnectedAt        DateTime? @map("meta_connected_at")
  metaConnectionStatus   String?   @map("meta_connection_status")
  uazapiInstanceId       String?   @map("uazapi_instance_id")
  uazapiInstanceName     String?   @map("uazapi_instance_name")
  uazapiToken            String?   @map("uazapi_token") @db.Text
  uazapiConnectionStatus String?   @map("uazapi_connection_status")
  uazapiConnectedAt      DateTime? @map("uazapi_connected_at")
  webhookToken           String?   @unique @default(uuid()) @map("webhook_token")
  plan                   String?
  maxDiscountPercentage  Decimal?  @default(0) @map("max_discount_percentage")
  leadRoutingMode        String    @default("manual") @map("lead_routing_mode")
  openHour               String    @default("08:00") @map("open_hour")
  contactCadence         Int       @default(5) @map("contact_cadence")
  closeHour              String    @default("20:00") @map("close_hour")
  chargeConsultation     Boolean   @default(false) @map("charge_consultation")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  owner                    Professional?             @relation("CompanyOwner", fields: [ownerId], references: [id])
  professionals            Professional[]            @relation("CompanyProfessionals")
  usuarios                 Usuario[]
  userCompanyAccess        UserCompanyAccess[]
  userCompanyPermissions   UserCompanyPermission[]
  agentesIa                AgenteIa[]
  conversas                Conversa[]
  conversationLabels       ConversationLabel[]
  roles                    Role[]
  clients                  Client[]
  leads                    Lead[]
  leadStatuses             LeadStatus[]
  leadOrigins              LeadOriginConfig[]
  appointments             Appointment[]
  payments                 Payment[]
  funnelConfigs            FunnelConfig[]
  messageCampaigns         MessageCampaign[]
  messageCreditWallet      MessageCreditWallet?
  messageCreditTransactions MessageCreditTransaction[]
  tasks                    Task[]
  notifications            Notification[]
  subscription             CompanySubscription?
  billingAddons            BillingAddon[]
  googleCalendarConnection GoogleCalendarConnection?
  whatsappConnection       WhatsAppConnection?
  whatsappTemplates        WhatsAppTemplate[]
  whatsappWebhookEvents    WhatsAppWebhookEvent[]
  cadenceConfigs           CadenceConfig[]
  goals                    Goal[]

  @@map("empresas")
}

model WhatsAppConnection {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique @map("company_id")
  provider             String
  officialMode         String?   @map("official_mode")
  status               String    @default("disconnected")
  phoneNumberId        String?   @map("phone_number_id")
  wabaId               String?   @map("waba_id")
  businessId           String?   @map("business_id")
  displayPhoneNumber   String?   @map("display_phone_number")
  accessToken          String?   @map("access_token") @db.Text
  webhookVerifyToken   String?   @map("webhook_verify_token")
  externalInstanceId   String?   @map("external_instance_id")
  externalInstanceName String?   @map("external_instance_name")
  metadata             Json?
  connectedAt          DateTime? @map("connected_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company       Empresa                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templates     WhatsAppTemplate[]
  webhookEvents WhatsAppWebhookEvent[]

  @@index([provider, status])
  @@map("whatsapp_connections")
}

model WhatsAppTemplate {
  id              Int       @id @default(autoincrement())
  companyId       Int       @map("company_id")
  connectionId    Int?      @map("connection_id")
  externalId      String?   @map("external_id")
  name            String
  language        String
  category        String
  status          String
  qualityScore    String?   @map("quality_score")
  rejectionReason String?   @map("rejection_reason") @db.Text
  components      Json
  parameterFormat String?   @map("parameter_format")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company    Empresa             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  campaigns  MessageCampaign[]

  @@unique([companyId, name, language])
  @@index([companyId, status])
  @@map("whatsapp_templates")
}

model WhatsAppWebhookEvent {
  id           Int       @id @default(autoincrement())
  companyId    Int?      @map("company_id")
  connectionId Int?      @map("connection_id")
  provider     String
  eventKey     String    @unique @map("event_key")
  eventType    String?   @map("event_type")
  status       String    @default("pending")
  attempts     Int       @default(0)
  payload      Json
  errorMessage String?   @map("error_message") @db.Text
  processedAt  DateTime? @map("processed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Empresa?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("whatsapp_webhook_events")
}

model GoogleCalendarConnection {
  id           Int       @id @default(autoincrement())
  companyId    Int       @unique @map("company_id")
  googleEmail  String?   @map("google_email")
  calendarId   String    @default("primary") @map("calendar_id")
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  scope        String?
  tokenType    String?   @map("token_type")
  expiryDate   BigInt?   @map("expiry_date")
  status       String    @default("connected")
  lastSyncAt   DateTime? @map("last_sync_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  company      Empresa   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

model UserCompanyAccess {
  userId    Int      @map("user_id")
  companyId Int      @map("company_id")
  roleId    Int?     @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Empresa  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id])
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company_access")
}

model Usuario {
  id                  Int       @id @default(autoincrement())
  companyId           Int?      @map("company_id")
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  roleId              Int?      @map("role_id")
  leadRoutingWeight   Int       @default(1) @map("lead_routing_weight")
  isActive            Boolean   @default(true) @map("is_active")
  googleId            String?   @unique @map("google_id")
  authProvider        String?   @default("local") @map("auth_provider")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  emailVerified       Boolean   @default(true) @map("email_verified")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company                Empresa?                @relation(fields: [companyId], references: [id])
  companyAccess          UserCompanyAccess[]
  role                   Role?                   @relation(fields: [roleId], references: [id])
  permissions            UserPermission[]
  companyPermissions     UserCompanyPermission[]
  proposalsAsSalesperson Proposal[]              @relation("SalespersonProposals")
  proposalsAsSpecialist  Proposal[]              @relation("SpecialistProposals")
  proposalsAsSdr         Proposal[]              @relation("SdrProposals")
  leadsAsSdr             Lead[]                  @relation("LeadSdr")
  leadsAsCloser          Lead[]                  @relation("LeadCloser")
  leadsAsEspecialista    Lead[]                  @relation("LeadEspecialista")
  appointmentsAsSDR      Appointment[]           @relation("AppointmentSDR")
  appointmentsAsEspec    Appointment[]           @relation("AppointmentEspecialista")
  assignedTasks          Task[]                  @relation("AssignedUserTasks")
  createdTasks           Task[]                  @relation("CreatedUserTasks")
  notifications          Notification[]          @relation("UserNotifications")
  conversasAtribuidas    Conversa[]              @relation("ConversationAssignedUser")
  conversationNotes      ConversationNote[]      @relation("ConversationNoteUser")
  conversationEvents     ConversationEvent[]     @relation("ConversationEventUser")

  @@map("usuarios")
